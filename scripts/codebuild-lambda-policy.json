{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateFreshMartLambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-south-2:*:function:csv_reader_lambda",
        "arn:aws:lambda:ap-south-2:*:function:data_transformer_worker",
        "arn:aws:lambda:ap-south-2:*:function:pipeline_orchestrator"
      ]
    }
  ]
}